index 0000000..36615ec
--- /dev/null
+++ b/src/auth/config.ts
@@ -0,0 +1,19 @@
+/** Authentication is optional: with VITE_AUTH_ENABLED unset or not "true" the app behaves as it always did (open). */
+export interface OidcConfig {
+  authority: string;
+  clientId: string;
+  scope: string;
+  /** Extra authorize parameter some providers need, for example Auth0's `audience`. */
+  audience?: string;
+}
+
+type Env = Record<string, string | undefined>;
+
+export const isAuthEnabled = (env: Env = import.meta.env as Env): boolean => env.VITE_AUTH_ENABLED === "true";
+
+export function readOidcConfig(env: Env = import.meta.env as Env): OidcConfig {
+  const authority = env.VITE_OIDC_AUTHORITY;
+  const clientId = env.VITE_OIDC_CLIENT_ID;
+  if (!authority || !clientId) throw new Error("VITE_AUTH_ENABLED is true, so set VITE_OIDC_AUTHORITY and VITE_OIDC_CLIENT_ID");
+  return { authority, clientId, scope: env.VITE_OIDC_SCOPE ?? "openid profile", audience: env.VITE_OIDC_AUDIENCE || undefined };
+}
