+++ b/src/auth/RequireCatalogWrite.tsx
@@ -0,0 +1,23 @@
+import { useEffect, type ReactNode } from "react";
+import { Link } from "react-router";
+import { useAuth } from "./AuthProvider";
+
+/** Guards the create and edit routes. With auth off it renders its children, as before. The server is what really enforces access. */
+export function RequireCatalogWrite({ children }: { children: ReactNode }) {
+  const { enabled, loading, identity, canWriteCatalog, login } = useAuth();
+  const needsLogin = enabled && !loading && !identity;
+  useEffect(() => { if (needsLogin) void login(); }, [needsLogin, login]);
+
+  if (!enabled) return <>{children}</>;
+  if (loading || needsLogin) return <p>Checking your login…</p>;
+  if (!canWriteCatalog) {
+    return (
+      <div className="empty">
+        <h2>You need the editor role</h2>
+        <p>You are signed in as {identity?.name}, but changing movies and people needs the editor or moderator role.</p>
+        <Link to="/movies">Back to movies</Link>
+      </div>
+    );
+  }
+  return <>{children}</>;
+}
diff --git a/src/auth/claims.test.ts b/src/auth/claims.test.ts
new file mode 100644
index 0000000..1687081
--- /dev/null
+++ b/src/auth/claims.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it } from "vitest";
+import { can, decodePayload, identityFromToken, isModerator } from "./claims";
+
+function token(claims: Record<string, unknown>): string {
+  // Real tokens are UTF-8 bytes, base64url encoded (btoa alone mangles non-Latin1 text)
+  const b64 = (o: unknown) => btoa(String.fromCharCode(...new TextEncoder().encode(JSON.stringify(o)))).replace(/=+$/, "").replace(/\+/g, "-").replace(/\//g, "_");
+  return `${b64({ alg: "none" })}.${b64(claims)}.sig`;
+}
+
+describe("claims", () => {
+  it("decodes a base64url payload, including non-ASCII names", () => {
+    expect(decodePayload(token({ name: "Zoë Müller", n: 1 }))).toEqual({ name: "Zoë Müller", n: 1 });
+  });
+  it("rejects something that is not a JWT", () => {
+    expect(() => decodePayload("nope")).toThrow(/Not a JWT/);
+  });
+  it("derives permissions from roles", () => {
+    const id = identityFromToken(token({ sub: "1", name: "Alice", roles: ["user"] }));
+    expect(id).toEqual({ sub: "1", name: "Alice", roles: ["user"], permissions: ["reviews:write"] });
+    expect(can(id, "reviews:write")).toBe(true);
+    expect(can(id, "catalog:write")).toBe(false);
+  });
+  it("adds permissions the token carries itself (Auth0 RBAC style)", () => {
+    const id = identityFromToken(token({ sub: "2", permissions: ["catalog:write"] }));
+    expect(id.permissions).toEqual(["catalog:write"]);
+  });
+  it("editors can write the catalogue and moderators are flagged", () => {
+    expect(can(identityFromToken(token({ sub: "3", roles: ["editor"] })), "catalog:write")).toBe(true);
+    expect(isModerator(identityFromToken(token({ sub: "4", roles: ["moderator", "editor", "user"] })))).toBe(true);
+    expect(isModerator(identityFromToken(token({ sub: "5", roles: ["editor"] })))).toBe(false);
+  });
+  it("falls back through name, username, email and sub", () => {
+    expect(identityFromToken(token({ sub: "9", preferred_username: "zed" })).name).toBe("zed");
+    expect(identityFromToken(token({ sub: "9" })).name).toBe("9");
+  });
+  it("treats an absent identity as having no permissions", () => {
+    expect(can(undefined, "reviews:write")).toBe(false);
+    expect(isModerator(undefined)).toBe(false);
+  });
+});
diff --git a/src/auth/claims.ts b/src/auth/claims.ts
new file mode 100644
index 0000000..6ce5e7a
--- /dev/null
+++ b/src/auth/claims.ts
@@ -0,0 +1,36 @@
+/** Reading what a token says about the user. The browser only decodes the token to show and gate UI; the gateway and server verify it. */
+export interface Identity {
+  sub: string;
+  name: string;
+  roles: string[];
+  permissions: string[];
+}
+
+/** The gateway's default role -> permission map (gateway/rules.ts). Keep the two in step, or read permissions from the token. */
+export const ROLE_PERMISSIONS: Record<string, string[]> = {
+  user: ["reviews:write"],
+  editor: ["reviews:write", "catalog:write"],
+  moderator: ["reviews:write", "catalog:write"],
+};
+
+export function decodePayload(token: string): Record<string, unknown> {
+  const part = token.split(".")[1];
+  if (!part) throw new Error("Not a JWT");
+  const b64 = part.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(part.length / 4) * 4, "=");
+  const bytes = Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
+  return JSON.parse(new TextDecoder().decode(bytes)) as Record<string, unknown>;
+}
+
+const strings = (v: unknown): string[] => (Array.isArray(v) ? v.filter((x): x is string => typeof x === "string") : []);
+
+export function identityFromToken(token: string): Identity {
+  const claims = decodePayload(token);
+  const roles = strings(claims.roles);
+  const permissions = new Set<string>(strings(claims.permissions));
+  for (const role of roles) for (const p of ROLE_PERMISSIONS[role] ?? []) permissions.add(p);
+  const name = [claims.name, claims.preferred_username, claims.email, claims.sub].find((v): v is string => typeof v === "string" && v.length > 0) ?? "Unknown";
+  return { sub: String(claims.sub ?? ""), name, roles, permissions: [...permissions].sort() };
+}
+
+export const can = (identity: Identity | undefined, permission: string): boolean => !!identity?.permissions.includes(permission);
+export const isModerator = (identity: Identity | undefined): boolean => !!identity?.roles.includes("moderator");
