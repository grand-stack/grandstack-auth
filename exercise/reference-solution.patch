diff --git a/src/auth/AuthProvider.tsx b/src/auth/AuthProvider.tsx
new file mode 100644
index 0000000..bce05d3
--- /dev/null
+++ b/src/auth/AuthProvider.tsx
@@ -0,0 +1,97 @@
+import { User, UserManager, WebStorageStateStore } from "oidc-client-ts";
+import { createContext, useCallback, useContext, useEffect, useMemo, useState, type ReactNode } from "react";
+import { can, identityFromToken, type Identity } from "./claims";
+import { isAuthEnabled, readOidcConfig } from "./config";
+
+interface AuthState {
+  /** False when the app runs open (no login), as before. */
+  enabled: boolean;
+  loading: boolean;
+  identity?: Identity;
+  login: (returnTo?: string) => Promise<void>;
+  logout: () => Promise<void>;
+  /** Completes the redirect back from the identity provider and returns the path to go to. */
+  completeLogin: () => Promise<string>;
+  /** Whether to show create/edit/delete. Always true when auth is off. The server enforces the real rule. */
+  canWriteCatalog: boolean;
+}
+
+const Ctx = createContext<AuthState | null>(null);
+
+/** The token the urql client attaches to requests. */
+let currentToken: string | undefined;
+export const getAccessToken = (): string | undefined => currentToken;
+
+const OPEN: AuthState = {
+  enabled: false, loading: false, canWriteCatalog: true,
+  login: async () => {}, logout: async () => {}, completeLogin: async () => "/",
+};
+
+function createManager(): UserManager {
+  const config = readOidcConfig();
+  return new UserManager({
+    authority: config.authority,
+    client_id: config.clientId,
+    redirect_uri: `${window.location.origin}/callback`,
+    post_logout_redirect_uri: `${window.location.origin}/`,
+    response_type: "code", // authorization code with PKCE
+    scope: config.scope,
+    extraQueryParams: config.audience ? { audience: config.audience } : undefined,
+    automaticSilentRenew: true,
+    // sessionStorage keeps the session to this tab; scripts on the page can read it (XSS trade-off)
+    userStore: new WebStorageStateStore({ store: window.sessionStorage }),
+  });
+}
+
+export function AuthProvider({ children }: { children: ReactNode }) {
+  return isAuthEnabled() ? <OidcProvider>{children}</OidcProvider> : <Ctx.Provider value={OPEN}>{children}</Ctx.Provider>;
+}
+
+function OidcProvider({ children }: { children: ReactNode }) {
+  const manager = useMemo(createManager, []);
+  const [user, setUser] = useState<User | null>(null);
+  const [loading, setLoading] = useState(true);
+
+  useEffect(() => {
+    let alive = true;
+    const apply = (u: User | null) => {
+      currentToken = u && !u.expired ? u.access_token : undefined;
+      if (alive) setUser(u && !u.expired ? u : null);
+    };
+    manager.getUser().then((u) => { apply(u); if (alive) setLoading(false); }, () => { if (alive) setLoading(false); });
+    const onLoaded = (u: User) => apply(u);
+    const onGone = () => apply(null);
+    manager.events.addUserLoaded(onLoaded);
+    manager.events.addUserUnloaded(onGone);
+    manager.events.addAccessTokenExpired(onGone);
+    manager.events.addSilentRenewError(onGone);
+    return () => {
+      alive = false;
+      manager.events.removeUserLoaded(onLoaded);
+      manager.events.removeUserUnloaded(onGone);
+      manager.events.removeAccessTokenExpired(onGone);
+      manager.events.removeSilentRenewError(onGone);
+    };
+  }, [manager]);
+
+  const login = useCallback((returnTo = window.location.pathname + window.location.search) => manager.signinRedirect({ state: { returnTo } }), [manager]);
+  const logout = useCallback(async () => { currentToken = undefined; await manager.signoutRedirect(); }, [manager]);
+  const completeLogin = useCallback(async () => {
+    const u = await manager.signinRedirectCallback();
+    currentToken = u.access_token;
+    setUser(u);
+    return (u.state as { returnTo?: string } | undefined)?.returnTo ?? "/";
+  }, [manager]);
+
+  const value = useMemo<AuthState>(() => {
+    const identity = user ? identityFromToken(user.access_token) : undefined;
+    return { enabled: true, loading, identity, login, logout, completeLogin, canWriteCatalog: can(identity, "catalog:write") };
+  }, [loading, user, login, logout, completeLogin]);
+  return <Ctx.Provider value={value}>{children}</Ctx.Provider>;
+}
+
+export function useAuth(): AuthState {
+  const v = useContext(Ctx);
+  if (!v) throw new Error("useAuth must be used inside AuthProvider");
+  return v;
+}
diff --git a/src/auth/RequireCatalogWrite.tsx b/src/auth/RequireCatalogWrite.tsx
